{
  "name" : "autopilot-safe",
  "description" : "Autopilot with guardrails: reads/searches/builds run without prompts, destructive shell/writes are blocked or still confirmed, trusted subagent dispatch is auto-approved, though work is done inline by default.",
  "allowedTools" : [ "read", "grep", "glob", "code", "knowledge", "introspect", "goal", "todo_list", "@creds-agent" ],
  "tools" : [ "read", "write", "shell", "grep", "glob", "code", "knowledge", "introspect", "goal", "todo_list", "subagent", "@playwright", "@creds-agent" ],
  "mcpServers" : {
    "playwright" : {
      "command" : "npx",
      "args" : [ "-y", "@playwright/mcp@latest", "--headless", "--isolated", "--output-dir", ".screenshots" ]
    },
    "creds-agent" : {
      "command" : "aim",
      "args" : [ "mcp", "start-server", "local-creds-agent-mcp" ]
    }
  },
  "resources" : [ "file://~/.kiro/steering/**/*.md", "file://.kiro/steering/**/*.md" ],
  "toolsSettings" : {
    "shell" : {
      "autoAllowReadonly" : true,
      "allowedCommands" : [ "git status", "git diff.*", "git log.*", "git branch.*", "git show.*", "npm run build", "npm test", "npm run lint", "npm ci", "npm install" ],
      "deniedCommands" : [ "rm -rf.*", "sudo.*", "git push --force.*", "git push -f.*", "git reset --hard.*", "git clean -f.*", "git branch -D.*" ]
    },
    "write" : {
      "allowedPaths" : [ "src/**", "tests/**", "public/**", "*.json", "*.md", "*.ts", "*.svelte", "*.js", "*.css" ],
      "deniedPaths" : [ "*.env", "*.pem", "*.key", ".git/**", "node_modules/**" ]
    },
    "crew" : {
      "availableAgents" : [ "locate", "mechanical", "deadcode", "ux-advocate", "svelte-expert" ],
      "trustedAgents" : [ "locate", "mechanical", "deadcode", "ux-advocate", "svelte-expert" ]
    }
  },
  "hooks" : {
    "userPromptSubmit" : [ {
      "command" : "echo 'Reminders: (1) respond in caveman style — terse, drop articles/filler, keep technical accuracy. (2) Do the work inline: read the file, make the edit, run the command, measure the result. subagent is blocking-only, so it buys no parallelism and its verification claims have to be re-measured anyway. Dispatch only for read-heavy search whose file contents you do not want in context.'"
    } ]
  }
}